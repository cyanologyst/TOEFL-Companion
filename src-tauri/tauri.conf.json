{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TOEFL Companion",
  "version": "0.2.0",
  "identifier": "com.toeflcompanion.app",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TOEFL Companion",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 650,
        "center": true,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "shadow": true,
        "theme": "Light",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src ipc: http://ipc.localhost https://api.dictionaryapi.dev; font-src 'self' data:; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Education",
    "shortDescription": "Local-first TOEFL study companion",
    "longDescription": "A focused desktop companion for TOEFL vocabulary memorization, speaking practice, Academic Discussion writing, reminders, and study progress.",
    "publisher": "TOEFL Companion",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
